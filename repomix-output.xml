                email=admin_email,
                first_name='Admin',
                last_name='User',
                role=RoleEnum.ADMIN
            )
            admin.set_password(admin_password)
            db.session.add(admin)
            db.session.commit()
            app.logger.info(f"Admin user created: {admin_email}")
    
    @app.route('/health')
    def health_check():
        return {'status': 'healthy'}
    
    return app
